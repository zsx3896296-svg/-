<view class="container">
  <view class="card">
    <view class="field">
      <text class="label">标题</text>
      <input placeholder="请输入标题" value="{{title}}" bindinput="onTitleInput" />
    </view>
    <view class="field">
      <text class="label">内容</text>
      <textarea placeholder="请输入内容" value="{{content}}" bindinput="onContentInput" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input placeholder="仅认证可见" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
  </view>
  <view class="primary-btn" bindtap="onSubmit">发布</view>
</view>
