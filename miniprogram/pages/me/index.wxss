.title {
  font-weight: 600;
  margin-bottom: 12rpx;
}

input {
  border: 2rpx solid #e0e7ff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.row input {
  flex: 1;
  margin-bottom: 0;
}

.primary-btn.small {
  padding: 14rpx 20rpx;
  font-size: 24rpx;
}

.status {
  margin-top: 12rpx;
  color: #1f6fff;
}
